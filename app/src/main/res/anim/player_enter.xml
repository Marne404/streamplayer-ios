<?xml version="1.0" encoding="utf-8"?>
<!-- Player blendet über den dunklen Ladebildschirm: nur Deckkraft, keine Bewegung – der Film soll
     „angehen“, nicht hereinfahren. Kurve = spring-easing der Bewegungssprache. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="420"
    android:fromAlpha="0"
    android:toAlpha="1"
    android:interpolator="@anim/spring" />
